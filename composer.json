{
    "name": "devfactorych/ai-spam",
    "description": "AI-backed, queued spam protection for Laravel forms, powered by the Laravel AI SDK.",
    "keywords": [
        "laravel",
        "spam",
        "honeypot",
        "ai",
        "forms",
        "livewire"
    ],
    "homepage": "https://github.com/DevFactoryCH/ai-spam",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Cameron",
            "email": "mark.cameron@devfactory.ch"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.3",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "livewire/livewire": "^3.6|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required to use the WithAiSpam trait in Livewire components."
    },
    "autoload": {
        "psr-4": {
            "DevFactory\\AiSpam\\": "src/",
            "DevFactory\\AiSpam\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevFactory\\AiSpam\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevFactory\\AiSpam\\AiSpamServiceProvider"
            ],
            "aliases": {
                "AiSpam": "DevFactory\\AiSpam\\Facades\\AiSpam"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
